{
  "name": "combat-flight-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-based combat flight simulator: Rust/WASM physics, WebGPU + WebGL 2 rendering",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build-wasm.mjs && vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build-wasm.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path wasm/physics-engine/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webgpu/types": "^0.1.40",
    "typescript": "^6.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
